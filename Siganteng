name: Verify Human Identity

on:
  workflow_dispatch:
    inputs:
      agent_name:
        description: 'siganteng'
        required: true
        default: 'siganteng'

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Step 1 - Install ClawHub skill
        run: npx clawhub@latest install verified-agent-identity --force

      - name: Install script dependencies
        working-directory: scripts
        run: npm install

      - name: Step 2 - Create Wallet Baru + Derive Address
        run:  |
          rm -rf ~/.openclaw/billions/kms.json
          node scripts/createNewEthereumIdentity.js

          npm install ethers
          node -e "
          const { Wallet } = require('ethers');
          const fs = require('fs');
          const kms = JSON.parse(fs.readFileSync(process.env.HOME + '/.openclaw/billions/kms.json', 'utf8'));

          const pk = kms[0].privateKeyHex;
          const wallet = new Wallet(pk);

          fs.writeFileSync('wallet.txt',
            'Agent Name: ${{ github.event.inputs.agent_name }}\\n' +
            'Address: ' + wallet.address + '\\n' +
            'Private Key: ' + wallet.privateKey + '\\n'
          );

          console.log('=== WALLET BARU ===');
          console.log('Name:', '${{ github.event.inputs.agent_name }}');
          console.log('Address:', wallet.address);
          "

      - name: Save Wallet as Artifact
        uses: actions/upload-artifact@v4
        with:
          name: agent-wallet-${{ github.event.inputs.agent_name }}
          path: wallet.txt
          retention-days: 90

      - name: Step 3 - Link Human to Agent + Verify
        run:  |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "${{ github.event.inputs.agent_name }}", "description": "${{ github.event.inputs.agent_name }} AI Agent"}'
